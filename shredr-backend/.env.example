# ============================================================
# Shredr Backend — environment configuration
# Copy to .env and fill in your values. Loaded via dotenvy.
# ============================================================

# ---- PostgreSQL (all four are REQUIRED) --------------------
# The connection string is assembled in build_database_url() as:
#   postgres://{PGUSER}:{PGPASSWORD}@{PGHOST}/{PGDATABASE}?sslmode=require
#
# NOTE: PGHOST must include the port if it is not the default.
# NOTE: sslmode=require is always appended, so a plain local Postgres
#       without TLS will refuse the connection. Either enable SSL on the
#       server or adjust build_database_url() in src/main.rs for local work.
# The server panics on startup if any of these is missing.
PGHOST=localhost:5432
PGUSER=postgres
PGPASSWORD=password
PGDATABASE=shredr_db

# ---- Helius (REQUIRED) -------------------------------------
# Used to construct the Helius client at startup. The server panics
# without it, even though nothing currently calls the webhook endpoints.
HELIUS_API_KEY=your_helius_api_key

# ---- KYT screening (OPTIONAL, but nothing deposits without it) ----
# Base58 ed25519 key the compliance relayer signs deposit attestations with.
# Accepts a 32-byte seed or a 64-byte `seed || pubkey` keypair.
#
# Its PUBLIC key must match SHREDR_KYT_AUTHORITY in the deployed program, or
# every deposit is rejected on-chain with KytUnknownAuthority. The server logs
# the pubkey at startup so you can copy it across.
#
# Unset, /api/kyt/screen returns 503 per request rather than failing the boot.
# That is deliberate: a compliance key missing is worth seeing in the response,
# not discovering as a dead service three layers down.
#
# This key is the gate. Anyone holding it can clear any deposit.
KYT_AUTHORITY_KEY=

# How long an attestation stays valid, seconds. Defaults to 300.
#
# This is the replay window: the program binds an attestation to one burner but
# will honour it again for a top-up of the same PDA until it expires. Minutes,
# not days.
KYT_ATTESTATION_TTL_SECS=300

# Comma-separated base58 pubkeys refused before any provider is asked.
#
# An operator's hard block. Checked first and short-circuits the network call, so
# it still holds while the provider is down — and costs nothing when it hits.
KYT_DENYLIST=

# ---- Funder resolution ---------------------------------------
#
# Who funded a burner, read from the chain. The screening request carries only
# the burner: the client asking to be screened is exactly the party with a reason
# to name a cleaner address than the one that actually paid, so the relayer works
# it out itself and signs over the answer.

# JSON-RPC endpoint used for that lookup. Unset means every screening returns
# 503 — there is no fallback to anything the client claimed.
#
# MUST point at the cluster the deposits actually land on. This is deliberately
# separate from HELIUS_API_KEY above, which builds a mainnet-beta client: a
# devnet deposit resolved against mainnet finds no funding transfer at all, which
# reads as "no funder" and refuses every deposit.
KYT_RPC_URL=

# Optional; defaults shown.
# KYT_RPC_TIMEOUT_SECS=10
#
# Signatures walked back from the burner. A one-time burner has one funding
# transfer and a handful of transactions at most, so this bounds pathology
# rather than paging.
# KYT_RPC_SIGNATURE_LIMIT=20

# ---- Address screening (Solana Developer Platform) -----------
#
# The verdict source behind KYT_AUTHORITY_KEY's signature.
# POST https://api.solana.com/v1/compliance/address-screenings
# Docs: https://platform.solana.com/docs/tokens/freeze-and-compliance
#
# Providers must be configured on your SDP org first — there is no API for it,
# and the endpoint screens against "configured providers" only. See the quorum
# note below.

# SECRET. Backend only — never put this in a VITE_* var, which Vite inlines into
# the browser bundle and would publish it. Unset means every screening returns
# 503, not an allow.
SDP_API_KEY=

# Overrides, all optional; defaults shown.
# SDP_BASE_URL=https://api.solana.com
# SDP_NETWORK=solana
# SDP_TIMEOUT_SECS=10

# Business intent. One of transfer_destination | wallet_address_addition |
# unknown. None fits exactly — we screen a wallet *sending* into the pool, and
# transfer_destination describes one receiving — but it is the value SDP's own
# example uses.
# SDP_SCREENING_INTENT=transfer_destination

# riskScore at or above which a provider counts as having flagged the address.
#
# CALIBRATE THIS. The API documents no scale and no direction for riskScore; 7.0
# comes from the spec's single example, which pairs riskScore 7 with the label
# "High risk". Check it against real responses before trusting it.
# SDP_RISK_THRESHOLD=7.0

# How many providers must flag before a deposit is refused. Default 2, so one
# noisy vendor cannot refuse a depositor alone.
#
# A quorum of 2 needs 2 providers answering "ok". If fewer answer, the verdict is
# 503 rather than an allow — a quorum that cannot be reached has not acquitted
# anyone. SET THIS TO 1 if your org has only one provider configured, or every
# deposit will 503.
# SDP_FLAG_QUORUM=2

# Comma-separated riskLevel labels that flag on their own, case-insensitive.
# Empty by default: the labels are provider-specific free text, so guessing them
# is a silent no-op. Fill in once you have seen what your providers return —
# needed for any provider that returns a label but a null riskScore.
# SDP_RISK_LEVEL_DENY=high risk,severe

# ---- Server ------------------------------------------------
# CORS mode. Anything other than "development" enables the production
# allowlist (https://shredr.fun, https://www.shredr.fun — hardcoded in
# src/main.rs).
#
# WARNING: if ENVIRONMENT is unset it defaults to development, which
# allows ANY origin. Always set this explicitly in production.
ENVIRONMENT=development

# Listen port. Defaults to 8000 when unset.
PORT=8000

# Tracing filter.
RUST_LOG=shredr_backend=debug,tower_http=debug,sqlx=info
KYT_SECRET=1vqa9jt3ig7khphpsqqgv1m3m8v4g0a3g9vb5cl5remsl1dei7j3
KYT_ID=78851855mhls91ddvtnmugppho
KYT_ENDPOINT=https://svc.cipherowl.ai/oauth/token
