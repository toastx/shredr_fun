# ============================================================
# shredr.fun frontend — environment configuration
# Copy to .env.local (or .env) and fill in your values.
# ============================================================
#
# Every variable below is read at runtime. There are no hardcoded
# fallbacks in src/lib/constants.ts — an unset variable resolves to ""
# and the feature that depends on it will fail (with a console warning
# in dev builds).
#
# Vite inlines these at BUILD time, so a container/CI build needs them
# present in the build environment, not just at runtime.
#
# See docs/frontend/configuration.md for the full picture.

# ============================================================
# Environment selector (constant: ENVIRONMENT)
# ============================================================
# `dev`  -> every VITE_* below is read from its VITE_DEV_* twin instead.
# anything else, or unset -> the plain VITE_* values are used.
#
# Defaults to production deliberately: a typo or a missing value must not hand
# a deployed build a developer's endpoints. You opt in to dev, not out of it.
#
# If dev is selected and a VITE_DEV_* var is empty, the plain one is used and a
# console warning names it. That fallback keeps a partial dev config working,
# but a dev build quietly pointed at production infrastructure is exactly the
# thing you want to be told about.
VITE_ENVIRONMENT=prod

# Kora relayer endpoint (constant: KORA_RELAYER_URL)
VITE_KORA_RELAYER_URL=http://localhost:8080

# Kora endpoint for rollup transactions — PrivateTransfer / Commit /
# CommitAndUndelegate (constant: KORA_ROLLUP_RELAYER_URL).
#
# A second Kora, same signers.toml, with RPC_URL pointed at the MagicBlock
# rollup instead of devnet. Kora simulates every signTransaction against its
# own RPC, so a rollup blockhash sent to the devnet-facing instance above is
# rejected with "Blockhash not found", and vice versa.
#   kora --rpc-url https://devnet.magicblock.app --config kora.toml \
#        rpc start -p 8081 --signers-config signers.toml
VITE_KORA_ROLLUP_RELAYER_URL=http://localhost:8081

# Kora's relayer pubkey — the fee payer account Kora signs as
# (constant: KORA_RELAYER_PUBKEY).
# Also read directly by getEnvironmentRelayerPubkey() in src/lib/KoraRelayer.ts.
# Resolution order:
#   import.meta.env.VITE_KORA_RELAYER_PUBKEY / KORA_RELAYER_PUBKEY
#   → globalThis.__KORA_RELAYER_PUBKEY__
#   → process.env.*
#   → the Kora service's getConfig
# Must match the key your Kora deployment actually signs with, or
# instructions are built with the wrong relayer account and fail
# signature verification (program error 6007, MissingSigner).
VITE_KORA_RELAYER_PUBKEY=shredrWUYk1famp42neAhaJb9PAB69WoSTDhMUdcbjS

# Solana base-layer RPC (constants: HELIUS_RPC_URL, HELIUS_WSS_URL)
#
# NOTE: the API key ships in the client bundle, so it is public by
# construction. Use a key that is scoped/rate-limited accordingly.
VITE_HELIUS_RPC_URL=https://devnet.helius-rpc.com/?api-key=YOUR_HELIUS_API_KEY
VITE_HELIUS_WSS_URL=wss://devnet.helius-rpc.com/?api-key=YOUR_HELIUS_API_KEY

# MagicBlock ephemeral rollup (constants: MAGICBLOCK_RPC_URL, MAGICBLOCK_WSS_URL)
# Note: MAGICBLOCK_WSS_URL is declared in constants.ts but unused.
VITE_MAGICBLOCK_RPC_URL=https://devnet.magicblock.app
VITE_MAGICBLOCK_WSS_URL=wss://devnet.magicblock.app

# Backend API (constant: API_BASE_URL)
VITE_API_BASE_URL=http://localhost:8000

# Compliance relayer that screens depositors and signs deposit attestations
# (constant: KYT_API_URL). Falls back to VITE_API_BASE_URL when unset, which is
# where the placeholder screening endpoint lives.
#
# Deliberately separate from Kora: that key pays fees and can broadcast, this
# one only signs 90-byte messages. Splitting them keeps a compromised screening
# service to "can clear deposits it should not have" rather than "can move
# money". Point them at the same host only in development.
VITE_KYT_API_URL=http://localhost:8000

# ============================================================
# DEV twins — used only when VITE_ENVIRONMENT=dev
# ============================================================
# One per variable above. Same meanings; see the notes there.

VITE_DEV_KORA_RELAYER_URL=http://localhost:8080
VITE_DEV_KORA_ROLLUP_RELAYER_URL=http://localhost:8081
VITE_DEV_KORA_RELAYER_PUBKEY=shredrWUYk1famp42neAhaJb9PAB69WoSTDhMUdcbjS

VITE_DEV_HELIUS_RPC_URL=https://devnet.helius-rpc.com/?api-key=YOUR_DEV_HELIUS_API_KEY
VITE_DEV_HELIUS_WSS_URL=wss://devnet.helius-rpc.com/?api-key=YOUR_DEV_HELIUS_API_KEY

VITE_DEV_MAGICBLOCK_RPC_URL=https://devnet.magicblock.app
VITE_DEV_MAGICBLOCK_WSS_URL=wss://devnet.magicblock.app

VITE_DEV_API_BASE_URL=http://localhost:8000
